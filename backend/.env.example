# DeenVoice backend configuration. Copy to .env (git-ignored) or set in your host's secret store.
# There are NO default secrets: the server will not start without the required ones.

# --- Required -------------------------------------------------------------
# 32 random bytes, base64: openssl rand -base64 32     (encrypts stored voice samples and songs)
BLOB_ENCRYPTION_KEY=
# 32+ random characters: openssl rand -hex 32          (signs short-lived audio links)
MEDIA_SIGNING_KEY=

# --- Provider (server-side only; never put these in the Flutter app) -------
# "none" (default) = nothing can be generated and every endpoint says so.
PROVIDER=none
# PROVIDER=mureka
# MUREKA_API_KEY=
# MUREKA_BASE_URL=https://api.mureka.ai
# MUREKA_MODEL=auto
# Path of the "Vocal cloning" operation. The official reference (read 2026-10-29) gives
# POST /v1/song/vocal-clone (file: mp3/m4a, 15-30 s). It has never been run, so it stays OFF until you set it;
# while unset, voice enrollment fails closed.
# MUREKA_VOCAL_CLONE_PATH=/v1/song/vocal-clone
# Restrict where result audio may be downloaded from (comma-separated host suffixes). Recommended once known.
# MUREKA_AUDIO_HOSTS=
# Rate-card estimates in millionths of a USD, used only for cost reporting.
# MUREKA_SONG_COST_MICROS=45000
# MUREKA_ENROLL_COST_MICROS=5000000
# Evaluation only: allow lyrics languages the provider does NOT document, e.g. hausa,arabic.
# Results from these runs are experiments, never advertised capabilities.
# EXPERIMENTAL_LANGUAGES=

# --- Operations -----------------------------------------------------------
# 24+ characters. Enables operator endpoints (credit grants, metrics). Leave unset to disable them.
# ADMIN_TOKEN=
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/deenvoice.sqlite
BLOB_DIR=./data/blobs
# Comma-separated browser origins allowed to call the API (e.g. the web build). Empty = none.
CORS_ORIGINS=
CREDITS_PER_SONG=1
JOB_DEADLINE_MINUTES=20
# Must exceed the slowest single provider step (60 s download).
JOB_LEASE_SECONDS=120
MAX_VOICE_BYTES=26214400
MAX_LYRICS_CHARS=3000

# --- Live PoC runner only (scripts/live-poc.ts) ----------------------------
# POC_ACCOUNT_PASSWORD=
